<UserControl x:Class="FlowTunnel.Desktop.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel Padding="32" Spacing="16" MaxWidth="720" HorizontalAlignment="Left"><TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Routing mode" FontSize="18" FontWeight="SemiBold"/><ToggleSwitch Header="All applications use VPN except selected Direct rules" OffContent="Only selected VPN rules use VPN" OnContent="Unselected applications use VPN" IsOn="{Binding IsAllAppsMode, Mode=TwoWay}" AutomationProperties.HelpText="Changing this setting restarts an active tunnel."/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Opacity="0.72"/></StackPanel></Border><Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><TextBlock Text="Security" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Direct fallback is allowed because a Windows Filtering Platform kill switch is not implemented. If the engine exits, close protected applications until the tunnel reconnects." TextWrapping="Wrap"/><TextBlock Text="Theme follows the Windows system setting." Opacity="0.72"/></StackPanel></Border></StackPanel></UserControl>
