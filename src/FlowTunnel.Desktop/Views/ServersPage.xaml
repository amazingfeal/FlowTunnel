<UserControl x:Class="FlowTunnel.Desktop.Views.ServersPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="Servers" Style="{StaticResource PageTitleStyle}"/>
    <TextBox Grid.Row="1" Header="Connection URI" PlaceholderText="vless://, vmess://, trojan://, ss://, socks://, or http://" Text="{Binding ImportText, Mode=TwoWay}" TextWrapping="NoWrap" AutomationProperties.HelpText="Credentials are stored in the current-user profile and are never written to normal logs."/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"><Button Content="Import" Command="{Binding ImportCommand}" MinHeight="40" AccessKey="I"/><TextBlock Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
    <ListView Grid.Row="3" ItemsSource="{Binding Profiles}" SelectionMode="None"><ListView.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold"/><TextBlock><Run Text="{Binding Protocol}"/><Run Text=" · "/><Run Text="{Binding Server}"/><Run Text=":"/><Run Text="{Binding Port}"/></TextBlock></StackPanel><TextBlock Grid.Column="1" Text="Validated on connect" VerticalAlignment="Center" Opacity="0.72"/></Grid></Border></DataTemplate></ListView.ItemTemplate></ListView>
  </Grid>
</UserControl>
