<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FlowTunnel" Manufacturer="FlowTunnel contributors" Version="0.1.0" UpgradeCode="2E48AB94-91A8-44A0-BC56-6FEF90BF4B13" Scope="perMachine" Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of FlowTunnel is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FlowTunnel">
        <Directory Id="DesktopFolder" Name="Desktop" />
        <Directory Id="ServiceFolder" Name="Service" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder"><Directory Id="ProgramMenuFlowTunnel" Name="FlowTunnel" /></StandardDirectory>

    <Feature Id="MainFeature" Title="FlowTunnel" Level="1">
      <ComponentGroupRef Id="DesktopPayload" />
      <ComponentGroupRef Id="ServicePayload" />
      <ComponentRef Id="EnginePayload" />
      <ComponentRef Id="TunnelService" />
      <ComponentRef Id="DesktopExecutable" />
    </Feature>

    <ComponentGroup Id="DesktopPayload" Directory="DesktopFolder"><Files Include="$(var.DesktopPublish)\**" Exclude="$(var.DesktopPublish)\FlowTunnel.Desktop.exe" /></ComponentGroup>
    <ComponentGroup Id="ServicePayload" Directory="ServiceFolder"><Files Include="$(var.ServicePublish)\**" Exclude="$(var.ServicePublish)\FlowTunnel.Service.exe" /></ComponentGroup>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="EnginePayload" Guid="*">
        <File Id="SingBoxExe" Source="$(var.PayloadRoot)\sing-box.exe" KeyPath="yes" />
        <File Id="EngineMetadata" Source="$(var.PayloadRoot)\engine.json" />
        <File Id="SingBoxLicense" Source="$(var.PayloadRoot)\sing-box-LICENSE.txt" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="ServiceFolder">
      <Component Id="TunnelService" Guid="*">
        <File Id="ServiceExe" Source="$(var.ServicePublish)\FlowTunnel.Service.exe" KeyPath="yes" />
        <ServiceInstall Id="InstallTunnelService" Name="FlowTunnel.Service" DisplayName="FlowTunnel Tunnel Service" Description="Runs the approved sing-box TUN engine with elevated privileges." Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <ServiceControl Id="ControlTunnelService" Name="FlowTunnel.Service" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopExecutable" Guid="*">
        <File Id="DesktopExe" Source="$(var.DesktopPublish)\FlowTunnel.Desktop.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFlowTunnel" Name="FlowTunnel" WorkingDirectory="DesktopFolder" Advertise="yes" />
        </File>
      </Component>
    </DirectoryRef>
  </Package>
</Wix>
