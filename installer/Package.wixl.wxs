<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="FlowTunnel" Language="1033" Version="$(var.ProductVersion)" Manufacturer="FlowTunnel contributors" UpgradeCode="2E48AB94-91A8-44A0-BC56-6FEF90BF4B13">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of FlowTunnel is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch FlowTunnel" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="FlowTunnel">
          <Directory Id="DesktopDir" Name="Desktop" />
          <Directory Id="ServiceDir" Name="Service" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuFlowTunnel" Name="FlowTunnel" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="DesktopDir">
      <Component Id="DesktopComponent" Guid="*" Win64="yes">
        <File Id="DesktopExe" Source="$(var.DesktopExe)" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFlowTunnel" Name="FlowTunnel" WorkingDirectory="DesktopDir" Advertise="yes" />
        </File>
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="ServiceDir">
      <Component Id="ServiceComponent" Guid="*" Win64="yes">
        <File Id="ServiceExe" Source="$(var.ServiceExe)" KeyPath="yes" />
        <ServiceInstall Id="InstallTunnelService" Name="FlowTunnel.Service" DisplayName="FlowTunnel Tunnel Service" Description="Runs the approved Xray TUN engine with elevated privileges." Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" />
        <ServiceControl Id="ControlTunnelService" Name="FlowTunnel.Service" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="EngineComponent" Guid="*" Win64="yes">
        <File Id="XrayExe" Source="$(var.XrayExe)" KeyPath="yes" />
        <File Id="EngineMetadata" Source="$(var.EngineMetadata)" />
        <File Id="XrayLicense" Source="$(var.XrayLicense)" />
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="*" Win64="yes">
        <Condition>CREATE_DESKTOP_SHORTCUT = "1"</Condition>
        <Shortcut Id="DesktopShortcut" Name="FlowTunnel" Description="FlowTunnel per-application VPN" Target="[DesktopDir]FlowTunnel.Desktop.exe" WorkingDirectory="DesktopDir" />
        <RegistryValue Root="HKLM" Key="Software\FlowTunnel" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <CustomAction Id="LaunchFlowTunnel" FileKey="DesktopExe" ExeCommand="" Execute="immediate" Return="asyncNoWait" Impersonate="yes" />

    <UIRef Id="FlowTunnelUI" />
    <UIRef Id="WixUI_Common" />

    <Feature Id="MainFeature" Title="FlowTunnel" Level="1">
      <ComponentRef Id="DesktopComponent" />
      <ComponentRef Id="ServiceComponent" />
      <ComponentRef Id="EngineComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Product>
</Wix>
